{
  "entities": {
    "Conversation": {
      "title": "Conversation",
      "description": "A chat conversation session with CSU Mitra",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the conversation",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID of the student or visitor",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Summary or title of the chat",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message within a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the message",
          "maxLength": 128
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who owns this message stream",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Role of the sender"
        },
        "content": {
          "type": "string",
          "description": "Content of the message",
          "maxLength": 15000
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when message was generated"
        }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Top-level collection for CSU chat sessions"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Subcollection containing all messages for a specific conversation"
    }
  }
}
